{
  "name": "dsh-tls-fallback",
  "version": "0.1.0",
  "description": "Provider-selectable DNS/TLS connection fallback for DeepSeek Harness, without fixed IPs or duplicate model requests",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["src/*.mjs", "dist/client.js", "cordis.patch.yml", "locale/*.json", "README*.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-api-remotes"]
    }
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/SerzhSharapa/dsh-tls-fallback.git" },
  "homepage": "https://github.com/SerzhSharapa/dsh-tls-fallback#readme",
  "bugs": { "url": "https://github.com/SerzhSharapa/dsh-tls-fallback/issues" },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": { "node": ">=22.19.0" },
  "dependencies": { "@deepseek-ai/schemastery": "~3.18.4", "undici": "8.11.2" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-http-proxy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-http-proxy": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true }
  },
  "devDependencies": { "esbuild": "^0.25.0" },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "tls", "dns", "connection-fallback"]
}
